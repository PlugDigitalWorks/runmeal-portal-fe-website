{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runmeal-portal-fe-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "runmeal-portal-fe-website"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Staging: deployed from the `staging` branch with `npm run deploy:staging`
  "env": {
    "staging": {
      "name": "runmeal-portal-fe-website-staging",
      "routes": [
        {
          "pattern": "staging-portalfe.runmeal.com",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "runmeal-portal-fe-website-staging"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
